############################################################
# Keep Docker builds fast, lean, and free of secrets.
############################################################

# Dependencies (installed inside Docker)
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js / build outputs
.next/
out/
dist/
build/
.vercel/

# Tests
coverage/
.nyc_output/
__tests__/
__mocks__/
*.test.*
*.spec.*

# Local / editor
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log

# Environment variables — never bake secrets into the image.
.env
.env*.local
.env.development
.env.test
.env.production.local
.env.docker

# Docker / compose (not needed in build context)
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Docs / CI
*.md
!SECURITY.md
docs/
.github/
.gitlab-ci.yml

# Caches / temp
.cache/
.eslintcache
.swc/
.turbo/
.tmp/
.temp/
*.tsbuildinfo

# Secrets / keys
*.pem
*.key
*.p12

# OS junk
.DS_Store
Thumbs.db

# Agent / AI tooling
.cursor/
AGENTS.md
.agents/
