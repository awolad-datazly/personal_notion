# Supabase Postgres.
# App runtime (Vercel): Transaction pooler, port 6543.
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Migrations only (`pnpm db:migrate`). Direct connection, port 5432.
# Do not use the transaction pooler here. URL-encode special characters in the password.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# Public site URL. No trailing slash. Google redirects here.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# Comma-separated hosts allowed for Server Actions.
# On Vercel this also includes VERCEL_URL automatically.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Stable key shared across multiple app instances (openssl rand -base64 32).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Google OAuth. In Google Cloud → Credentials → OAuth client:
# Authorized JavaScript origin: {AUTH_URL}
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# This Google account receives the ADMIN role. Every other account is USER.
AUTH_ADMIN_EMAIL=

# Community support widget (bKash). Amount is shown on the floating badge.
NEXT_PUBLIC_BKASH_AMOUNT=20
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
# Optional. If empty, a QR is generated from NEXT_PUBLIC_BKASH_NUMBER.
NEXT_PUBLIC_BKASH_QR_URL=

# Set to 1 only for CI image smoke builds that intentionally skip env checks.
# SKIP_ENV_VALIDATION=
