# Neon serverless Postgres. Use the pooled connection string for the Next.js server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# Public site URL (OAuth callback base). Required in production / Docker.
AUTH_URL=http://localhost:3000

# Comma-separated hosts (or full URLs) allowed for Server Actions CSRF checks.
# Defaults to AUTH_URL. Example: localhost:3000,devhub.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Stable key shared across multiple app instances (openssl rand -base64 32).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Google OAuth. Authorized redirect URI:
# {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# This Google account receives the ADMIN role. Every other account is USER.
AUTH_ADMIN_EMAIL=

# Community support widget (bKash). Amount is shown on the floating badge.
NEXT_PUBLIC_BKASH_AMOUNT=20
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
# Optional. If empty, a QR is generated from NEXT_PUBLIC_BKASH_NUMBER.
NEXT_PUBLIC_BKASH_QR_URL=

# Set to 1 only for CI image smoke builds that intentionally skip env checks.
# SKIP_ENV_VALIDATION=
