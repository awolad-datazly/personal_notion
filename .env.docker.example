# Copy to `.env.docker` (gitignored) for Compose / production containers.
# Never commit real secrets.

# Host port published by Compose
APP_PORT=3000

# Public origin the browser uses (OAuth redirects + server actions CSRF)
AUTH_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional when running more than one app replica
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Supabase transaction pooler (port 6543) for the running app
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ADMIN_EMAIL=

# Optional public support widget
NEXT_PUBLIC_BKASH_AMOUNT=20
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_BKASH_QR_URL=
